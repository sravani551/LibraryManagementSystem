#!/usr/bin/env sh
# ----------------------------------------------------------------------------
# Maven Wrapper - Unix shell script
#
# This script will execute the maven wrapper jar (.mvn/wrapper/maven-wrapper.jar)
# ----------------------------------------------------------------------------
MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" ]; then
  java -jar "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" "$@"
else
  echo "Maven wrapper jar not found at $MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
  echo "Run download-maven-wrapper.cmd on Windows or fetch the wrapper jar manually."
  exit 1
fi

